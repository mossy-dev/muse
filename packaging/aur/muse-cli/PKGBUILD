# Maintainer: Jake Carr <jake.carr@mail.randomsound.org>
#
# The package is muse-cli because extra/muse is already the MusE sequencer, and
# the AUR does not take a name the official repositories hold. The binary stays
# muse: MusE installs /usr/bin/muse4, so nothing collides on disk.

pkgname=muse-cli
pkgver=0.1.0
pkgrel=1
pkgdesc='Composable music theory CLI: scales, chords, voicings and MIDI, in pipelines'
arch=('x86_64' 'aarch64')
url='https://github.com/mossy-dev/muse'
license=('MIT')
depends=('glibc')
makedepends=('odin')
provides=('muse-cli')
conflicts=('muse-cli-bin')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

# Built to ./build, never to ./muse. `odin test src/muse` in check() names its
# test binary after the package directory, so a binary called muse would be
# overwritten and then deleted before package() could install it. ./build is
# also where the transcript runner looks.
build() {
  cd "muse-$pkgver"
  odin build src/cli -o:speed -out:build -define:MUSE_VERSION="$pkgver"
  ./tools/manpage.sh build > muse.1
  ./tools/completions.sh build bash > muse.bash
  ./tools/completions.sh build zsh > _muse
  ./tools/completions.sh build fish > muse.fish
}

check() {
  cd "muse-$pkgver"
  odin test src/muse
  odin test src/cli
  ./tests/transcript.sh
  ./tests/completions.sh
}

package() {
  cd "muse-$pkgver"
  install -Dm755 build "$pkgdir/usr/bin/muse"
  install -Dm644 muse.1 "$pkgdir/usr/share/man/man1/muse.1"
  install -Dm644 muse.bash "$pkgdir/usr/share/bash-completion/completions/muse"
  install -Dm644 _muse "$pkgdir/usr/share/zsh/site-functions/_muse"
  install -Dm644 muse.fish "$pkgdir/usr/share/fish/vendor_completions.d/muse.fish"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
